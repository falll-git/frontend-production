NEXT_PUBLIC_API_URL=https://api.arsip.example.com/api/v1
# Hostname backend yang memang menjadi pasangan deployment ini. Nilainya harus
# sama persis dengan hostname pada NEXT_PUBLIC_API_URL.
RUWANG_API_HOSTNAME=api.arsip.example.com

# Branding dipilih saat build. Nilai valid:
# demoruwangarsip, arthamadani, bogotegarberiman, riyalirsyadi
# APP_INSTANCE_KEY dan NEXT_PUBLIC_APP_BRAND wajib sama agar brand tidak tertukar.
APP_INSTANCE_KEY=demoruwangarsip
NEXT_PUBLIC_APP_BRAND=demoruwangarsip
# Override ukuran opsional per deployment (pixel, rentang aman 160-720).
NEXT_PUBLIC_RUWANG_LOGO_MAX_WIDTH=
NEXT_PUBLIC_PARTNER_LOGO_MAX_WIDTH=
# Ukuran ikon pemisah X untuk brand mitra (pixel, rentang aman 20-64).
NEXT_PUBLIC_BRAND_SEPARATOR_SIZE=

# Generate once on server: openssl rand -base64 32
# Simpan stabil pada shared credentials milik BPRS, di luar setiap release.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Production wajib memakai file ini dan tidak boleh mengisi nilai langsung di atas.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY_FILE=/srv/ruwang/demoruwangarsip/shared/credentials/frontend/NEXT_SERVER_ACTIONS_ENCRYPTION_KEY

# Keduanya wajib full commit SHA 40 karakter yang sama pada production.
NEXT_DEPLOYMENT_ID=<full_commit_sha>
NEXT_PUBLIC_APP_RELEASE=<full_commit_sha>

# Browser test only. Simpan nilai sebenarnya sebagai environment variable/CI secret.
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_USERNAME=
E2E_PASSWORD=

# Optional: dipakai quality gate lintas-repository untuk menyalakan backend lokal.
E2E_BACKEND_DIR=
E2E_BACKEND_HEALTH_URL=http://127.0.0.1:7111/health
E2E_BACKEND_NODE_ENV=development
E2E_REUSE_FRONTEND_BUILD=false
# Khusus backend E2E terkelola; tidak mengubah default limiter production.
E2E_AUTH_RATE_LIMIT_MAX=250
