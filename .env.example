NEXT_PUBLIC_API_URL=https://api.arsip.example.com/api/v1

# Generate once on server: openssl rand -base64 32
# Keep this value stable across build/start and every PM2 instance.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Alternatif secret store/systemd credentials (jangan isi bersamaan dengan nilai di atas):
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY_FILE=/run/credentials/ruwang-arsip-web/NEXT_SERVER_ACTIONS_ENCRYPTION_KEY

# Optional but recommended per deploy, for example git commit hash.
# Helps Next.js handle version skew by forcing a full reload for older clients.
NEXT_DEPLOYMENT_ID=
# Metadata non-rahasia untuk korelasi error frontend, biasanya commit hash yang sama.
NEXT_PUBLIC_APP_RELEASE=

# Browser test only. Simpan nilai sebenarnya sebagai environment variable/CI secret.
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_USERNAME=
E2E_PASSWORD=

# Optional: dipakai quality gate lintas-repository untuk menyalakan backend lokal.
E2E_BACKEND_DIR=
E2E_BACKEND_HEALTH_URL=http://127.0.0.1:7111/health
E2E_BACKEND_NODE_ENV=development
E2E_REUSE_FRONTEND_BUILD=false
# Khusus backend E2E terkelola; tidak mengubah default limiter production.
E2E_AUTH_RATE_LIMIT_MAX=250
